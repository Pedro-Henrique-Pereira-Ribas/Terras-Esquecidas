# Conexão do Postgres.
# O projeto usa o Postgres gerenciado do Neon (plano gratuito).
# Connection string em: Neon Console > Connection Details > Pooled connection
#
# IMPORTANTE: no Neon use a conexão "Pooled" (o host contém "-pooler").
# E use sslmode=verify-full: o node-postgres não suporta channel_binding=require.
DATABASE_URL=postgresql://neondb_owner:SENHA@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# O Neon exige TLS na conexão.
DATABASE_SSL=true

# Porta fornecida pelo Render. Em local, 3001 é o padrão.
PORT=3001
HOST=0.0.0.0

# Origens permitidas, separadas por vírgula. Use * para liberar geral.
# Ex.: https://terras-esquecidas.onrender.com,http://localhost:4173
CORS_ORIGIN=*

# Tempo de validade da sessão em dias.
SESSION_DAYS=30

# Custo do bcrypt. 12 é um bom padrão para produção.
BCRYPT_ROUNDS=12

# Executa o schema automaticamente ao iniciar. Mantenha true no Render.
AUTO_MIGRATE=true

# Serve o frontend estático na mesma porta da API.
SERVE_FRONT=true

# Pasta do frontend. Vazio = detecção automática (../front a partir de back/).
# FRONT_DIR=../front

# Quantidade de proxies confiáveis à frente do app. O Render usa 1.
TRUST_PROXY=1

# Log das requisições: silent, info ou debug.
LOG_LEVEL=info

# E-mail do dono do Reino. E o unico que ve e aprova os pedidos de conta
# e que libera contas de administracao. Vazio = ninguem pode liberar.
OWNER_EMAIL=seu-email@exemplo.com
