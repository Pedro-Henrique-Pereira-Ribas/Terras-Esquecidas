# Conexão do Postgres do Render.
# Use a Internal Database URL quando a API estiver no mesmo Render;
# use a External Database URL para rodar a API na sua máquina.
DATABASE_URL=postgres://usuario:senha@host:5432/terra_perdida

# Render Postgres interno normalmente não usa SSL. Para conexão externa, use true.
DATABASE_SSL=false

# Porta fornecida pelo Render. Em local, 3001 é o padrão.
PORT=3001
HOST=0.0.0.0

# Origens permitidas, separadas por vírgula. Use * para liberar geral.
# Em produção o frontend é servido pela própria API, então a origem é a mesma
# e o CORS nem chega a ser aplicado. Deixe * e use só as locais se for testar.
CORS_ORIGIN=*

# Tempo de validade da sessão em dias.
SESSION_DAYS=30

# Custo do bcrypt. 12 é um bom padrão para produção.
BCRYPT_ROUNDS=12

# Executa o schema automaticamente ao iniciar. Mantenha true no Render.
AUTO_MIGRATE=true

# Serve o frontend estático (pasta front/) na mesma porta da API.
SERVE_FRONT=true

# Pasta do frontend. Vazio = detecção automática (../front a partir de back/).
# FRONT_DIR=../front

# Quantidade de proxies confiáveis à frente do app. O Render usa 1.
TRUST_PROXY=1

# Log das requisições: silent, info ou debug.
LOG_LEVEL=info
