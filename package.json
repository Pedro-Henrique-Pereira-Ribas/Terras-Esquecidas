{
  "name": "terra-perdida",
  "version": "1.0.0",
  "private": true,
  "description": "Terra Perdida — plataforma 2D em pixel art, com arte e áudio procedurais.",
  "scripts": {
    "serve": "node scripts/static-server.mjs front 4173",
    "dev": "node scripts/dev.mjs",
    "dev:front": "node scripts/static-server.mjs front 4173",
    "dev:back": "npm --prefix back run dev",
    "api:install": "npm --prefix back install",
    "api:dev": "npm --prefix back run dev",
    "api:build": "npm --prefix back run build",
    "api:start": "npm --prefix back start",
    "api:test": "npm --prefix back test",
    "api:typecheck": "npm --prefix back run typecheck",
    "front:test": "node --test \"front/test/*.test.js\"",
    "test": "npm run api:test && npm run front:test"
  },
  "author": "Pedro Henrique Pereira Ribas",
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
